# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: URL of your Mealie instance
# Example: https://mealie.yourdomain.com or http://localhost:9000
MEALIE_BASE_URL=

# Required: API key for Mealie authentication
# Generate this in your Mealie user settings
MEALIE_API_KEY=

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# Optional: Set to 'true' in containerized environments to disable file logging
# This is automatically set in the Dockerfile
# CONTAINER=true

# Home Assistant Configuration (Optional)
# Required for meal planning context with activity calendars
HA_URL=
HA_TOKEN=

# Custody Pattern Configuration (Optional)
# Pattern name from custody_patterns.py library
# Default: 2-2-3-2-2-3-blended
CUSTODY_PATTERN=2-2-3-2-2-3-blended

# Cycle anchor date (day 0 of the pattern)
# Format: YYYY-MM-DD
# Default: 2026-01-26
CUSTODY_CYCLE_START=2026-01-26

# Available custody patterns:
# - 2-5-5-2: 2 days A, 5 days B, 5 days A, 2 days B (14-day cycle)
# - 3-4-4-3: 3 days A, 4 days B, 4 days A, 3 days B (14-day cycle)
# - 2-2-3: 2 days A, 2 days B, 3 days A (7-day cycle)
# - 2-2-5-5: 2-2-5-5 pattern (14-day cycle)
# - week-on-week-off: Alternating weeks (14-day cycle)
# - every-other-weekend: Weekdays A, alternating weekends (14-day cycle)
# - 2-2-3-2-2-3-blended: Custom blended family (14-day cycle)
#     2 days girls only, 2 days boys only, 3 days both together,
#     2 days girls only, 2 days boys only, 3 days neither (parent respite)
